                             [.CONFIG FILE v0.89.1]

[SETUP]
# === Subtitle Script Setup ===

# API_KEY: Your OpenSubtitles consumer API key
# USERNAME: Your OpenSubtitles username
# PASSWORD: Your OpenSubtitles password
# API_URL: OpenSubtitles API endpoint (only change if OpenSubtitles updates their API URL)
api_key= 
username= 
password= 
api_url= https://api.opensubtitles.com/api/v1

# - OMDB_API_KEY: Your OMDb API key for IMDb metadata lookup (get free key at http://www.omdbapi.com/apikey.aspx)
#   Used to find IMDb IDs for more accurate subtitle searching. Free tier: 1000 requests/day.
#   If empty or lookup fails, falls back to text-based search.
#   Recommended: Get a free key for better search accuracy.
omdb_api_key= 

# - LANGUAGES: Subtitle languages to download, in priority order (e.g. nl,en).
#   Removing a language with preserve_unwanted_subtitles=false will delete all .srt files for that language.
#   The order also determines the priority order and default track of internal/embedded subtitle tracks
#   (the first listed language present in the file becomes the default track when available). Does not affect external .srt files.
languages= en,nl

# - AUDIO_TRACK_LANGUAGES: Audio languages to keep in video files, in priority order (e.g. nl,en,ja). 'undefined' tracks are always kept.
#   Recommended: Keep 'en' (95% of movies have English audio). Set to 'ALL' to disable audio processing.
#   The order also determines the priority order and default track of the audio tracks
#   (the first listed language present in the file becomes the default track when available in the video).
audio_track_languages= en,nl,ja

# - MOVIES_ACCEPT_SCORE / SERIES_ACCEPT_SCORE: Quality score threshold for auto-accepting subtitles when using smart_sync.
#   Movies default: 70. Series default: 80 (series are harder to sync reliably due to shorter episodes,
#   more segmentation across episodes, and more room for subtitle errors across a full season).
#   Recommended movies: 70 (balanced) | 75+ (strict) | 65 and below (lenient)
#   Recommended series: 80 (balanced) | 85+ (strict) | 75 and below (lenient)
#   NOTE: A lenient setting might result in auto-accepts that are of poor quality, so be careful!
movies_accept_score= 70
series_accept_score= 80

# - AUTO_REJECT_SCORE: Quality score threshold for rejecting subtitles when using smart_sync.
#   Recommended: 20 (balanced) | 25+ (strict) | 15 and below (lenient)
#   Rejected subtitles won't be selected during synchronization
#   Lenient will allow for more syncs to get a chance during manual verification
#   Strict does the opposite, and will also burn through subtitle queries much quicker
auto_reject_score= 20

# - REQUIRE_IMDB_VALIDATION: IMDb validation confirms that the downloaded subtitle was       matched to the correct movie or episode.
#   If true, a subtitle must have been acquired with an IMDb match to be auto-accepted.
#   At a high movies_accept_score (70+) or series_accept_score (80+), a good quality score already strongly implies correct alignment, which can make IMDB validation quite strict when enabled.
#   Set to true for extra safety when using a lower accept score, where quality alone is a weaker signal, or set to true when you don't mind the extra manual verification.
require_imdb_validation= false

# - COUNT_REJECTED: If true, a subtitle is sent to manual verification when more than 50% of its batch was rejected.
#   The idea: too many rejections in a batch lower confidence in the winner, even if it scores well.
#   Set to false to disable this check entirely. The quality score alone then decides whether to auto-accept.
count_rejected= false

# - ACCEPT_OFFSET_THRESHOLD: Auto-accept syncs below this offset - ONLY used when smart_sync = false.
#   Offset is your most reliable quality metric. Lower = better sync quality, higher = more auto-accepts but riskier.
#   With smart_sync enabled, use movies_accept_score / series_accept_score instead (considers both offset AND correlation).
#   Recommended: 0.030-0.050 (strict) | 0.10-0.25 (balanced) | 5.0 (with IMDb+no rejections)
accept_offset_threshold= 5.0

# - REJECT_OFFSET_THRESHOLD: Subtitles above this offset (seconds) are marked as DRIFT - ONLY used when smart_sync = false (first match mode).
#   Higher = fewer rejections but poorer sync quality. Lower = faster rejections but runs out of candidates quickly.
#   With smart_sync enabled, use auto_reject_score instead (considers both offset AND correlation).
#   Recommended: 2.5-5.0 (strict) | 5.0-20.0 (balanced) | Increase if videos consistently run out of candidates without a sync.
reject_offset_threshold= 10

# - SERIES_MODE: True = process all videos in folder as TV episodes. False = only largest video (movie mode).
#   Built-in checks prevent wrong mode usage, but set carefully.
series_mode= true

# - SUBTITLE_BATCH_SIZE: Subtitles to download per batch. Smart sync tests this many before picking the best synced subtitle out of these.
#   Lower = preserves API limit, tests in batches. Limited downloads: 3-4. High limit (1000/day): 7-15 for increasingly better results. when smart_sync is set to true, 5 or higher is very recommended.
subtitle_batch_size= 8

# - SMART_SYNC: True = synchronize the whole downloaded batch, then pick the best subtitle based on quality score. False = accept first working subtitle.
#   Smart sync dramatically improves quality by comparing scores between subtitles for the same movie. First-match is faster but does not have the ability to cross-match, therefore lowering it's accuracy. Enabling smart_sync is very highly recommended.
smart_sync= true

# - QUALITY_SCORE_SKIP: Only used when smart_sync = true. If a subtitle scores at or above this threshold, the rest of the batch is skipped immediately and this subtitle is accepted. Recommended: 85 or higher. The idea is that the subtitle is very well synced, and therefore it's not necessary to synchronize the rest. You can only be certain of that with a very high quality score. Default is 90.
quality_score_skip= 90

# - FFSUBSYNC_ACCURACY: Subtitle synchronization engine (1-2).
#   1 = Webrtc: Pure audio-based voice detection. Fast and reliable. Scans video audio to detect speech moments.
#   2 = Subs_then_webrtc: Analyzes subtitle text structure first, then uses Webrtc as fallback. Slightly slower than 1 (webrtc), but slightly more accurate on average. This one is recommended.
#
#   Note: Auditok (too inaccurate, rejects everything) and Silero (slow, produces incorrect offsets) are not recommended as webrtc and subs do a much better job, much faster.
ffsubsync_accuracy= 2

# - USE_MOVIE_HASH: True = use video hash fingerprint for exact matching (95-99% accuracy), fallback to text search.
#   False = text-based search only (60-70% accuracy).
#   Recommended: true
use_movie_hash= true

# - LAST_RESORT_SEARCH: True = download ALL unfiltered subtitles when normal searches fail.
#   Often downloads wrong/irrelevant subtitles (wrong movie, version, language).
#   Recommended: false (quality over quantity) | Only set to true when you're doing a deep search for a subtitle you cannot find.
last_resort_search= false

# - DELETE_EXTRA_VIDEOS: True = delete extra videos. False = move to EXTRAS_FOLDER_NAME. (Ignored in series_mode).
# - EXTRAS_FOLDER_NAME: Folder name for moved extra videos.
delete_extra_videos= false
extras_folder_name= extras

# - PRESERVE_FORCED_SUBTITLES: True = keep forced subtitles (foreign dialogue). False = treat as regular subtitles.
# - PRESERVE_UNWANTED_SUBTITLES: True = keep all subtitle tracks. False = remove tracks not in LANGUAGES list.
preserve_forced_subtitles= false
preserve_unwanted_subtitles= false

# - RESYNC_MODE: True = Creates a folder called 'moved_subtitles', moves all existing subtitles to that folder and then does the whole Subservient run from scratch
# Set to false when you don't want to resync. Subservient will then work normally.
#   WARNING: Disable after use or it will keep moving new subtitles. You can delete all the created moved_subtitles automatically from within the 'Extra Tools' menu in Subordinate.py.
# You can even restore subtitles from the folder if you didn't manage to find a replacement (failed resync).
resync_mode= false

# - PAUSE_SECONDS: Seconds to pause between phases and summaries. Lower = faster, less time to read terminal output.
pause_seconds= 1

# - MAX_SEARCH_RESULTS: Maximum subtitle candidates to consider per movie.
#   More options = better matches but slower. Low download limit: max 10-12. VIP: 20+.
max_search_results= 20

# - DOWNLOAD_RETRY_503: Retry attempts for 503 server errors (OpenSubtitles temporarily overloaded).
download_retry_503= 6

# - SKIP_DIRS: Directory names to skip during video scanning (case-insensitive, use lowercase).
#   Add 'new folder' in your language to avoid processing temporary/feature folders.
skip_dirs= new folder,Soundtrack,Soundtracks,extra,extra's,extras,featurettes,bonus,bonusmaterial,bonus_material,behindthescenes,behind_the_scenes,deletedscenes,deleted_scenes,interviews,makingof,making_of,scenes,trailer,trailers,sample,samples,other,misc,specials,special_features,documentary,docs,docu,promo,promos,bloopers,outtakes,moved_subtitles

# - UNWANTED_TERMS: Technical terms to filter from search queries (e.g. codecs, quality tags, release groups).
#   Removes '[h.265 HEVC 10bit]' → cleaner queries → better matches. More terms = better search efficiency.
#   Legal: For content you own/have rights to process. Technical metadata filters serve interoperability only.
UNWANTED_TERMS= sample,cam,ts,workprint,unrated,uncut,720p,1080p,2160p,480p,576p,4k,5k,8k,uhd,imax,eng,ita,jap,hindi,web,webrip,web-dl,bluray,brrip,bdrip,dvdrip,hdrip,hdtv,remux,x264,x265,h.264,h.265,hevc,avc,hdr,hdr10,hdr10+,dv,dolby.vision,sdr,10bit,8bit,ddp,dd+,dts,aac,ac3,eac3,truehd,atmos,flac,opus,5.1,7.1,2.0,yts,yts.mx,yify,rarbg,fgt,galaxyrg,cm8,evo,sparks,drones,amiable,kingdom,tigole,chd,ddr,hdchina,cinefile,ettv,eztv,aXXo,maven,fitgirl,skidrow,reloaded,codex,cpy,conspir4cy,hoodlum,hive-cm8,vxt,ion10,psa,cmrg,rovers,ntb,deflate,metis,strife,sigma,qxr,joy,pahe,megusta,epsilon,omg,nogrp,swtyblz,amzn,nf,nflx,dsnp,amazon,netflix,disney,hulu,hbo,apple,paramount,mkv,mp4,avi,xvid,divx,wmv,m4v,mov,flv,webm,h265,mp3,internal,repack,readnf,proper,retail,extended,theatrical,directors.cut,criterion,unrated,remastered,extras,final.cut,open.matte,hybrid,version,v2,v3,limited,dubbed,subbed,multi,dual.audio,complete.series,complete.season,Licdom,ac,sub,nl,en,ita,eng,subs,rip,Anime Time,[Anime Time]

# - CONSOLE_WIDTH / CONSOLE_HEIGHT: Terminal window size in columns (chars per line) and rows (visible lines).
#   Only takes effect when launched via double-click on Windows (not in Windows Terminal).
console_width= 152
console_height= 36

# - RUN_COUNTER: Tracks run count for log organization. Don't change (may overwrite existing logs).
run_counter= 0

# === END OF SETUP ===
# ------------------------------------------------------------
# Everything below is managed automatically by the application.
# Only change this if you know what you are doing!

[RUNTIME]

--
JWT token for OpenSubtitles API. Acquisition.py will update this automatically.
[token]

--
List of movies that were skipped manually. Remove an entry below in order to make it appear again.
[skipped_movies]
